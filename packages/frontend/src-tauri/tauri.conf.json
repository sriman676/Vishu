{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vishu",
  "version": "0.0.0",
  "identifier": "com.vishu.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5800",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Vishu", "width": 1100, "height": 760 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}

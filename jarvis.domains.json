{
  "domains": [
    {
      "id": "composio",
      "note": "§11c: Composio's MCP server → 1000+ apps as namespaced composio__* tools. STUB — set COMPOSIO_API_KEY in .env and confirm the launch command matches your Composio CLI version; an unconfigured/missing binary is skipped at startup, never crashes serve. No `actions` map on purpose: each tool falls to the F0 gate's name heuristic (classifyTool), so composio__GMAIL_SEND_EMAIL classifies as send (always asks) while composio__*_FETCH_* classifies as read (auto). A blanket '*' override would wrongly declassify the send/delete tools.",
      "requireEnv": "COMPOSIO_API_KEY",
      "cmd": "npx",
      "args": [
        "-y",
        "@composio/mcp@latest",
        "start",
        "--transport",
        "stdio"
      ],
      "reconnect": false,
      "egressHosts": [
        "mcp.composio.dev",
        "backend.composio.dev",
        "api.composio.dev"
      ]
    },
    {
      "id": "browser",
      "cmd": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "reconnect": true,
      "actions": {
        "browser_click": "send",
        "browser_type": "send",
        "browser_fill_form": "send",
        "browser_press_key": "send",
        "browser_select_option": "send",
        "browser_file_upload": "send",
        "browser_drag": "send",
        "browser_evaluate": "change_setting",
        "*": "read"
      }
    },
    {
      "id": "github",
      "cmd": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "requireEnv": "GITHUB_PERSONAL_ACCESS_TOKEN",
      "reconnect": false,
      "egressHosts": [
        "api.github.com"
      ]
    },
    {
      "id": "whatsapp",
      "cmd": "C:\\Users\\srima\\.local\\bin\\uv.exe",
      "args": [
        "run",
        "--directory",
        "D:\\claude-tools\\repos\\whatsapp-mcp\\whatsapp-mcp-server",
        "main.py"
      ]
    },
    {
      "id": "filesystem",
      "cmd": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\Job Project"
      ]
    },
    {
      "id": "firecrawl",
      "cmd": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "requireEnv": "FIRECRAWL_API_KEY",
      "reconnect": false,
      "egressHosts": [
        "api.firecrawl.dev"
      ]
    }
  ]
}

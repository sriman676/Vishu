# Copy this file to .env and fill in your values. .env is gitignored — never commit real keys.
# Vishu loads .env from the working directory automatically (Node 24 native).

# Provider: openai, anthropic, ollama, mock — or a preset that auto-wires the endpoint + model:
#   gemini | openrouter | groq | deepseek   (all OpenAI-compatible; no base-url/model needed)
VISHU_PROVIDER=openai

# Your API key. Comma-separate for N-key automatic failover on quota/limit: VISHU_API_KEYS=key1,key2,key3
VISHU_API_KEY=

# Auto-detect: leave VISHU_PROVIDER unset and Vishu picks the provider from whichever standard key is set —
#   OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY / OPENROUTER_API_KEY / GROQ_API_KEY / DEEPSEEK_API_KEY
#   (each also accepts a comma-separated list of N keys).

# Optional overrides (sensible defaults per provider)
# VISHU_MODEL=gpt-4o-mini
# VISHU_BASE_URL=https://api.openai.com/v1

# Optional: enable feature-flagged modules (off by default), e.g. report,imagegen,wallet
# VISHU_MODULES=

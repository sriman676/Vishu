# Copy this file to .env and fill in your values. .env is gitignored — never commit real keys.
# Vishu loads .env from the working directory automatically (Node 24 native).

# Provider: openai, anthropic, ollama, mock — or a preset that auto-wires the endpoint + model:
#   gemini | openrouter | groq | deepseek | nvidia | mistral | together | fireworks | xai | perplexity | cohere
#   (all OpenAI-compatible; the preset supplies the base-url + a default model — override with VISHU_MODEL).
# Or just paste a key below and leave VISHU_PROVIDER unset — the provider is auto-detected from the key
# prefix (nvapi-→nvidia, sk-ant-→anthropic, AIza…→gemini, gsk_→groq, sk-or-→openrouter, fw_→fireworks,
# xai-→xai, pplx-→perplexity, sk-→openai) or a standard *_API_KEY env var (MISTRAL_API_KEY, XAI_API_KEY, …).
#
# Multiple DIFFERENT providers in parallel (e.g. Anthropic + OpenAI + local Ollama): declare them in the
# config file (~/.vishu/config.json or $VISHU_CONFIG) as `providers: { name: { type, apiKeys, model } }`,
# then set VISHU_KEY_MODE=balance to use them as a parallel pool (failover = one after another).
VISHU_PROVIDER=openai

# Your API key. Comma-separate for N-key automatic failover on quota/limit: VISHU_API_KEYS=key1,key2,key3
VISHU_API_KEY=

# Auto-detect: leave VISHU_PROVIDER unset and Vishu picks the provider from whichever standard key is set —
#   OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY / OPENROUTER_API_KEY / GROQ_API_KEY / DEEPSEEK_API_KEY
#   (each also accepts a comma-separated list of N keys).

# Optional overrides (sensible defaults per provider)
# VISHU_MODEL=gpt-4o-mini
# VISHU_BASE_URL=https://api.openai.com/v1

# Optional: enable feature-flagged modules (off by default), e.g. report,imagegen,wallet
# VISHU_MODULES=

# Multi-key routing across the keys above:
#   failover (default) = try one, rotate only on error | balance = round-robin every call across all keys
#   local = use local LLMs only when present. Add a local LLM to the ring with VISHU_LOCAL_BASE_URL.
# VISHU_KEY_MODE=balance
# VISHU_LOCAL_BASE_URL=http://127.0.0.1:11434

# --- §11a email/calendar daily-driver (OAuth stubbed — connectors throw until a token is set) ---
# Gmail / Outlook mail token, and Google / Outlook calendar token. Real OAuth wiring is pending;
# setting a token flips the stub connector to "configured" (send still hits the F0 gate).
# VISHU_GMAIL_TOKEN=
# VISHU_OUTLOOK_TOKEN=
# VISHU_GCAL_TOKEN=

# --- §11c Composio (1000+ apps via MCP) — declared in jarvis.domains.json, key stubbed here ---
# Set your Composio key; the composio domain attaches its MCP tools as composio__* (each reaching the
# F0 gate). Unset/misconfigured = the domain is skipped at startup (never crashes serve).
# COMPOSIO_API_KEY=

# --- §11h(ii) channels: Telegram / Slack / SMS (outbound; tokens stubbed) ---
# Each channel attaches only when its token(s) are set (otherwise send throws "not configured").
# Inbound arrives via the connectors_inbound RPC (your webhook receiver normalizes into it).
# Telegram bot token; Slack bot token (xoxb-…); Twilio SID+token+from-number for SMS.
# VISHU_TELEGRAM_TOKEN=
# VISHU_SLACK_TOKEN=
# VISHU_TWILIO_SID=
# VISHU_TWILIO_TOKEN=
# VISHU_TWILIO_FROM=

# --- Browser automation lane (token-free actuator) — enable with VISHU_MODULES=browser ---
# Drives your REAL logged-in Chrome so the PA acts as you in any signed-in app (Gmail, calendar, Slack,
# job boards) with NO OAuth/tokens. Point this at your Chrome "User Data" dir (close Chrome first, or use
# a copied profile). Safety: navigate/read/type auto; any Send/Buy/Delete/Submit click goes through
# browser_commit → the F0 gate always asks (typed SEND) + screenshots first. Instant pause halts it.
# Windows default profile: C:\Users\srima\AppData\Local\Google\Chrome\User Data
# VISHU_CHROME_PROFILE=
# VISHU_BROWSER_CHANNEL=chrome   # or msedge / chromium
# Requires: pnpm add playwright (optional dep) + npx playwright install chrome
